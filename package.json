{
  "name": "@chenhom/reviewer",
  "version": "0.1.0",
  "description": "Deterministic, fail-closed review decision engine: decides which changed files can skip human review.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.14"
  },
  "bin": {
    "reviewer": "bin/reviewer.js"
  },
  "files": [
    "bin",
    "src",
    "analyzers/php/bin",
    "analyzers/php/src",
    "analyzers/php/composer.json",
    "analyzers/php/composer.lock",
    "analyzers/ts/bin",
    "analyzers/ts/src"
  ],
  "scripts": {
    "docker:build": "docker build --tag reviewer:local .",
    "review:docker": "npm run docker:build && sh bin/review-docker.sh",
    "analyzer:install": "composer install --working-dir=analyzers/php --no-interaction",
    "lint": "eslint bin src tests evaluation analyzers/ts/bin analyzers/ts/src",
    "test": "node --test",
    "test:safety": "node --test",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:docker": "npm run docker:build && docker run --rm --network none reviewer:local sh bin/test-docker.sh",
    "test:all": "npm run lint && npm run test:safety && npm run test:e2e && npm run test:coverage && npm run eval:mutations && npm run eval:historical",
    "test:coverage": "c8 --all --include='src/**/*.js' --check-coverage --lines 90 --functions 90 --branches 85 --statements 90 npm run test:safety",
    "eval:mutations": "node evaluation/mutations/run.js",
    "eval:historical": "node evaluation/historical/run.js",
    "eval:real-repo": "node evaluation/real-repo/cli.js"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "simple-git-hooks": "^2.13.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "typescript": "5.9.3"
  }
}
